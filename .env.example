# API
API_PORT=4000
JWT_SECRET=change-me-super-secret

# URL pública del sitio (enlaces de recuperación de contraseña)
APP_PUBLIC_URL=https://album.dennyrosales.com

# Correo — recuperación de contraseña
# Opción A (producción): Mailtrap Sending API — dominio verificado album.dennyrosales.com
# Host API: send.api.mailtrap.io | Auth: Bearer <MAILTRAP_API_TOKEN>
MAILTRAP_API_TOKEN=
MAILTRAP_API_MODE=sending
SMTP_FROM="La Bolsa de Cromos <hello@album.dennyrosales.com>"
# MAILTRAP_INBOX_ID=123456  # solo si MAILTRAP_API_MODE=sandbox

# Opción B: SMTP Sandbox (solo pruebas, bandeja Mailtrap)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

PASSWORD_RESET_TTL_HOURS=2

# Prisma / DB
DATABASE_URL=postgresql://postgres:password@localhost:5432/cromos?schema=public
PRISMA_CLIENT_ENGINE_TYPE=library

# Economia / Trueques
DAILY_BONUS_COINS=20
TRADE_TTL_HOURS=48
TRADE_EXPIRY_SWEEP_MS=300000

# Superusuario (script npm run superuser:create)
SUPERUSER_EMAIL=email
SUPERUSER_PASSWORD=password
SUPERUSER_NAME=Superusuario
SUPERUSER_USERNAME=superadmin

# Quiniela / Clima (OpenWeatherMap plan gratuito: ~60 req/min, 1000/día)
# La API key tarda 10min-2h en activarse tras crearla (401 hasta entonces es normal)

WEATHER_CACHE_HOURS=24
WEATHER_REFRESH_MS=86400000
PREDICTION_LOCK_MINUTES=15
QUINIELA_POINTS_BASIC=10
QUINIELA_POINTS_PARTIAL=5
QUINIELA_POINTS_EXACT=25
QUINIELA_COINS_PER_POINT=2
QUINIELA_EXACT_BONUS_COINS=100
TRADE_POINTS_PER_SWAP=5
MAX_TRADE_POINTS_PER_DAY=3
