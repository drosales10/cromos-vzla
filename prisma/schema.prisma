generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id         String   @id @db.Uuid
  username   String   @unique
  name       String
  email      String?  @unique
  passwordHash String? @map("password_hash")
  city       String?
  whatsapp   String?
  provincia  String?
  canton     String?
  avatarUrl  String?  @map("avatar_url")
  albumPrefs Json?    @map("album_prefs")
  groups     String[] @default([])
  blocked    Boolean  @default(false)
  isAdmin    Boolean  @default(false) @map("is_admin")
  isSuperuser Boolean @default(false) @map("is_superuser")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cromos              UserCromos?
  groupsOwned         Group[]        @relation("GroupAdmin")
  groupMemberships    GroupMember[]
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")
  messagesSent        Message[]
  wallet              UserWallet?
  walletLedger        WalletLedger[]
  packInventory       UserPackInventory[]
  openings            PackOpening[]
  couponRedemptions   CouponRedemption[]
  couponsCreated      Coupon[]
  auditLogsCreated    AuditLog[]
  sentTrades          TradeProposal[] @relation("TradeFromUser")
  receivedTrades      TradeProposal[] @relation("TradeToUser")
  stickerInventory    UserStickerInventory[]

  @@index([blocked])
  @@index([isAdmin])
  @@index([isSuperuser])
  @@index([provincia, canton])
  @@map("profiles")
}

enum StickerRarity {
  COMMON
  SPECIAL
  GOLD
}

enum CouponRewardType {
  COINS
  PACK
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model StickerCatalog {
  id        String        @id
  section   String
  number    String
  rarity    StickerRarity @default(COMMON)
  weight    Int           @default(100)
  imagePath String?       @map("image_path")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  openingItems PackOpeningItem[]
  inventoryItems UserStickerInventory[]

  @@index([section])
  @@index([rarity])
  @@index([active])
  @@map("sticker_catalog")
}

model UserStickerInventory {
  userId     String   @map("user_id") @db.Uuid
  stickerId  String   @map("sticker_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker StickerCatalog @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@id([userId, stickerId])
  @@index([userId])
  @@index([stickerId])
  @@map("user_sticker_inventory")
}

model PackType {
  id         String   @id
  name       String
  size       Int      @default(5)
  priceCoins Int      @default(100) @map("price_coins")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  inventories UserPackInventory[]
  openings    PackOpening[]
  coupons     Coupon[]

  @@map("pack_types")
}

model UserWallet {
  userId           String    @id @map("user_id") @db.Uuid
  coins            Int       @default(0)
  lastDailyClaimAt DateTime? @map("last_daily_claim_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

model WalletLedger {
  id           String   @id @default(cuid())
  userId       String   @map("user_id") @db.Uuid
  entryType    String   @map("entry_type")
  amount       Int
  balanceAfter Int      @map("balance_after")
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entryType])
  @@map("wallet_ledger")
}

model UserPackInventory {
  userId     String   @map("user_id") @db.Uuid
  packTypeId String   @map("pack_type_id")
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  packType PackType @relation(fields: [packTypeId], references: [id], onDelete: Restrict)

  @@id([userId, packTypeId])
  @@index([packTypeId])
  @@map("user_pack_inventory")
}

model PackOpening {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  packTypeId String   @map("pack_type_id")
  source     String
  costCoins  Int      @default(0) @map("cost_coins")
  couponCode String?  @map("coupon_code")
  createdAt  DateTime @default(now()) @map("created_at")

  user     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packType PackType          @relation(fields: [packTypeId], references: [id], onDelete: Restrict)
  items    PackOpeningItem[]
  redemptions CouponRedemption[]

  @@index([userId, createdAt])
  @@index([packTypeId])
  @@map("pack_openings")
}

model PackOpeningItem {
  id        String   @id @default(cuid())
  openingId String   @map("opening_id")
  slot      Int
  stickerId String   @map("sticker_id")
  isNew     Boolean  @default(false) @map("is_new")
  isDouble  Boolean  @default(false) @map("is_double")
  createdAt DateTime @default(now()) @map("created_at")

  opening PackOpening    @relation(fields: [openingId], references: [id], onDelete: Cascade)
  sticker StickerCatalog @relation(fields: [stickerId], references: [id], onDelete: Restrict)

  @@index([openingId, slot])
  @@index([stickerId])
  @@map("pack_opening_items")
}

model Coupon {
  code         String           @id
  rewardType   CouponRewardType @map("reward_type")
  coinsAmount  Int?             @map("coins_amount")
  packTypeId   String?          @map("pack_type_id")
  packQuantity Int              @default(1) @map("pack_quantity")
  startsAt     DateTime?        @map("starts_at")
  endsAt       DateTime?        @map("ends_at")
  maxGlobalUses Int?            @map("max_global_uses")
  maxPerUser   Int              @default(1) @map("max_per_user")
  usedCount    Int              @default(0) @map("used_count")
  active       Boolean          @default(true)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  packType    PackType?          @relation(fields: [packTypeId], references: [id], onDelete: SetNull)
  createdBy   Profile?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([active, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  code      String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  openingId String?  @map("opening_id")

  coupon  Coupon      @relation(fields: [code], references: [code], onDelete: Cascade)
  user    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opening PackOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)

  @@index([code, userId])
  @@index([userId, createdAt])
  @@map("coupon_redemptions")
}

model TradeProposal {
  id          String      @id @default(cuid())
  fromUserId  String      @map("from_user_id") @db.Uuid
  toUserId    String      @map("to_user_id") @db.Uuid
  status      TradeStatus @default(PENDING)
  giveIds     String[]    @default([]) @map("give_ids")
  receiveIds  String[]    @default([]) @map("receive_ids")
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  expiresAt   DateTime    @map("expires_at")
  respondedAt DateTime?   @map("responded_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  fromUser Profile @relation("TradeFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   Profile @relation("TradeToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, createdAt])
  @@index([toUserId, status, createdAt])
  @@index([status, expiresAt])
  @@map("trade_proposals")
}

model UserCromos {
  userId    String   @id @map("user_id") @db.Uuid
  have      String[] @default([])
  doubles   String[] @default([])
  need      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cromos")
}

model Group {
  id        String   @id
  name      String
  type      String
  code      String   @unique
  adminId   String   @map("admin_id") @db.Uuid
  members   String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin        Profile      @relation("GroupAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  groupMembers GroupMember[]

  @@index([type])
  @@index([adminId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Conversation {
  id          String   @id
  user1Id     String   @map("user1_id") @db.Uuid
  user2Id     String   @map("user2_id") @db.Uuid
  lastMessage String   @default("") @map("last_message")
  lastAt      DateTime @default(now()) @map("last_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user1    Profile   @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    Profile   @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([lastAt])
  @@map("conversations")
}

model Message {
  id             String   @id
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id") @db.Uuid
  text           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
